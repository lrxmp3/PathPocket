{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "artifact_id",
      "step",
      "type",
      "path",
      "sha256",
      "created_at",
      "source_artifacts",
      "description"
    ],
    "properties": {
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "source_artifacts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}